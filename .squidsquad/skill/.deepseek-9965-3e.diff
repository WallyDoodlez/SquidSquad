+# ---------------------------------------------------------------------------
+# #6274.2 D4 — upgrade_install: dev/qa → worker/verifier migration
+# ---------------------------------------------------------------------------
+
+class TestUpgradeInstall:
+    """D4 spec coverage per CONTEXT-6274.md and DS finding F6.
+
+    Paths covered: (a) full dev+qa migration, (b) idempotent re-run,
+    (c) partial-migration detection, (d) no-op on new-style install,
+    (e) .harness-state.json key rename, (f) missing config.md / .squidsquad/.
+    Plus regression tests for DS F1, F4, F5.
+    """
+
+    @staticmethod
+    def _seed_old_install(root, *, with_dev=True, with_qa=True,
+                          with_config=True, harness_agents=None):
+        """Lay down a pre-rename install layout under `root/.squidsquad/`."""
+        squid = root / ".squidsquad"
+        squid.mkdir(parents=True, exist_ok=True)
+        if with_config:
+            (squid / "config.md").write_text(
+                "# SquidSquad Config\n\n- **Dev Agents**: skill\n",
+                encoding="utf-8",
+            )
+        if with_dev:
+            (squid / "dev").mkdir()
+            (squid / "dev" / "marker.txt").write_text("dev", encoding="utf-8")
+        if with_qa:
+            (squid / "qa").mkdir()
+            (squid / "qa" / "marker.txt").write_text("qa", encoding="utf-8")
+        if harness_agents is not None:
+            (squid / ".harness-state.json").write_text(
+                json.dumps({"agents": harness_agents}, indent=2) + "\n",
+                encoding="utf-8",
+            )
+        return squid
+
+    # (a) full dev+qa → worker+verifier migration
+    def test_full_migration_renames_dirs_and_rewrites_config(self, tmp_path):
+        squid = self._seed_old_install(tmp_path)
+        result = wizard.upgrade_install(tmp_path)
+        assert result["ok"] is True
+        assert result["action"] == "migrated"
+        assert (squid / "worker").is_dir()
+        assert (squid / "verifier").is_dir()
+        assert not (squid / "dev").exists()
+        assert not (squid / "qa").exists()
+        # subfiles travel with the rename
+        assert (squid / "worker" / "marker.txt").read_text(encoding="utf-8") == "dev"
+        assert (squid / "verifier" / "marker.txt").read_text(encoding="utf-8") == "qa"
+        # config.md rewritten atomically (no .tmp left behind)
+        config_text = (squid / "config.md").read_text(encoding="utf-8")
+        assert "Workers" in config_text and "Dev Agents" not in config_text
+        assert not (squid / "config.md.tmp").exists()
+
+    # (b) idempotent re-run after successful migration
+    def test_idempotent_rerun_returns_noop(self, tmp_path):
+        self._seed_old_install(tmp_path)
+        wizard.upgrade_install(tmp_path)  # first run does the work
+        result2 = wizard.upgrade_install(tmp_path)
+        assert result2["ok"] is True
+        assert result2["action"] == "no-op"
+        assert result2["migrated"] == []
+
+    # (c) partial-migration detection (both dirs exist)
+    def test_partial_migration_both_dirs_exist_errors(self, tmp_path):
+        squid = self._seed_old_install(tmp_path)
+        (squid / "worker").mkdir()  # corrupt state: both dev/ and worker/
+        result = wizard.upgrade_install(tmp_path)
+        assert result["ok"] is False
+        assert result["action"] == "error"
+        assert result["exit_code"] == 2
+        assert "partial migration" in result["summary"]
+        # No changes applied — dev/ still present, config.md untouched
+        assert (squid / "dev").is_dir()
+        assert "Dev Agents" in (squid / "config.md").read_text(encoding="utf-8")
+
+    def test_partial_migration_config_workers_with_dev_dir_errors(self, tmp_path):
+        squid = self._seed_old_install(tmp_path, with_qa=False)
+        # config says new but dev/ still around → partial
+        (squid / "config.md").write_text(
+            "# SquidSquad Config\n\n- **Workers**: skill\n",
+            encoding="utf-8",
+        )
+        result = wizard.upgrade_install(tmp_path)
+        assert result["ok"] is False
+        assert result["action"] == "error"
+        assert result["exit_code"] == 2
+
+    # (d) no-op on new-style install (already migrated)
+    def test_noop_on_already_migrated_install(self, tmp_path):
+        squid = tmp_path / ".squidsquad"
+        squid.mkdir(parents=True)
+        (squid / "config.md").write_text(
+            "# SquidSquad Config\n\n- **Workers**: skill\n",
+            encoding="utf-8",
+        )
+        (squid / "worker").mkdir()
+        (squid / "verifier").mkdir()
+        result = wizard.upgrade_install(tmp_path)
+        assert result["ok"] is True
+        assert result["action"] == "no-op"
+        assert result["migrated"] == []
+
+    # (e) .harness-state.json key rename (covers qa→verifier and dev→worker)
+    def test_harness_state_keys_renamed(self, tmp_path):
+        squid = self._seed_old_install(
+            tmp_path,
+            harness_agents={
+                "pm": {"pid": 100, "intent": "running"},
+                "qa": {"pid": 101, "intent": "running"},
+                "dev": {"pid": 102, "intent": "running"},
+                "skill": {"pid": 103, "intent": "running"},  # variant key untouched
+            },
+        )
+        result = wizard.upgrade_install(tmp_path)
+        assert result["ok"] is True
+        state = json.loads((squid / ".harness-state.json").read_text(encoding="utf-8"))
+        agents = state["agents"]
+        assert "verifier" in agents and agents["verifier"]["pid"] == 101
+        assert "worker" in agents and agents["worker"]["pid"] == 102
+        assert "qa" not in agents and "dev" not in agents
+        # Variant keys (D5) untouched per CONTEXT-6274 line 66
+        assert agents["skill"]["pid"] == 103
+        assert agents["pm"]["pid"] == 100
+
+    # (f) missing config.md / .squidsquad/ — graceful degradation
+    def test_missing_squidsquad_dir_returns_noop(self, tmp_path):
+        # No .squidsquad/ at all
+        result = wizard.upgrade_install(tmp_path)
+        assert result["ok"] is True
+        assert result["action"] == "no-op"
+
+    def test_missing_config_md_with_dev_dir_still_migrates(self, tmp_path):
+        squid = self._seed_old_install(tmp_path, with_config=False)
+        result = wizard.upgrade_install(tmp_path)
+        assert result["ok"] is True
+        assert result["action"] == "migrated"
+        assert (squid / "worker").is_dir()
+        assert not (squid / "config.md").exists()
+
+    # DS F4 regression: both old+new keys in harness-state.json → error
+    def test_harness_state_both_keys_present_errors(self, tmp_path):
+        squid = self._seed_old_install(
+            tmp_path,
+            harness_agents={
+                "qa": {"pid": 101, "intent": "running"},
+                "verifier": {"pid": 999, "intent": "running"},  # collision
+            },
+        )
+        result = wizard.upgrade_install(tmp_path)
+        assert result["ok"] is False
+        assert result["action"] == "error"
+        assert result["exit_code"] == 2
+        assert "verifier" in result["summary"] and "qa" in result["summary"]
+        # The pre-existing verifier entry must NOT be clobbered
+        state = json.loads((squid / ".harness-state.json").read_text(encoding="utf-8"))
+        assert state["agents"]["verifier"]["pid"] == 999
+        assert state["agents"]["qa"]["pid"] == 101
+
+    def test_harness_state_malformed_json_is_non_fatal(self, tmp_path):
+        """DS F1 carve-out: a malformed state file is non-fatal (skip key rename).
+
+        OSError on read/write IS fatal (F1 fix), but a parse error is treated
+        as "agent never wrote a valid state file" — directory + config renames
+        still apply, and the upgrade reports migrated for those.
+        """
+        squid = self._seed_old_install(tmp_path)
+        (squid / ".harness-state.json").write_text("{bad json", encoding="utf-8")
+        result = wizard.upgrade_install(tmp_path)
+        assert result["ok"] is True
+        assert result["action"] == "migrated"
+        # Dir + config renames still happened
+        assert (squid / "worker").is_dir()
+        assert "Workers" in (squid / "config.md").read_text(encoding="utf-8")
+
+    # DS F5 regression: cmd_upgrade JSON output must NOT include `exit_code`
+    def test_cmd_upgrade_json_does_not_leak_exit_code(self, tmp_path, capsys):
+        # Trigger the error path (which sets exit_code internally)
+        squid = self._seed_old_install(tmp_path)
+        (squid / "worker").mkdir()  # partial — triggers exit_code=2
+        rc = wizard.cmd_upgrade([str(tmp_path)])
+        assert rc == 2
+        out = capsys.readouterr().out
+        payload = json.loads(out)
+        assert "exit_code" not in payload
+        assert payload["ok"] is False
+        assert payload["action"] == "error"
+
+
