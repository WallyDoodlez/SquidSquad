+                #   (b) present state file: load as-is (None when RUNNING/
+                #       STOPPED, or a float when STOPPING).
+                elif "intent_set_at" not in agent_data and (
+                    agent.intent == AgentState.INTENT_STOPPING
                 ):
                     agent.intent_set_at = time.time()
                 else:
