{
    "statusLine":  {
                       "type":  "command",
                       "command":  "bash .squidsquad/statusline.sh"
                   },
    "permissions":  {
                        "allow":  [
                                      "Bash(git rev-parse *)",
                                      "Bash(git log *)",
                                      "Bash(git rev-list *)",
                                      "Bash(git tag -l *)",
                                      "Bash(git diff *)",
                                      "Bash(git status*)",
                                      "Bash(git branch*)",
                                      "Bash(git show *)",
                                      "Bash(git blame *)",
                                      "Bash(git pull*)",
                                      "Bash(git add*)",
                                      "Bash(git commit*)",
                                      "Bash(git push*)",
                                      "Bash(git stash*)",
                                      "Bash(git checkout*)",
                                      "Bash(git tag *)",
                                      "Bash(git fetch*)",
                                      "Bash(git merge*)",
                                      "Bash(git hash-object*)",
                                      "Bash(git mktree*)",
                                      "Bash(git commit-tree*)",
                                      "Bash(cat *)",
                                      "Bash(head *)",
                                      "Bash(tail *)",
                                      "Bash(ls *)",
                                      "Bash(wc *)",
                                      "Edit(.squidsquad/**)",
                                      "Write(.squidsquad/**)",
                                      "Bash(echo * \u003e .squidsquad/*)",
                                      "Bash(echo * \u003e .squidsquad/*/*)",
                                      "Bash(echo * \u003e .squidsquad/*/*/*)",
                                      "Bash(cp * .squidsquad/*)",
                                      "Bash(cp * .squidsquad/*/*)",
