{
  "statusLine": {
    "type": "command",
    "command": "bash .squidsquad/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Edit(.squidsquad/**)",
      "Write(.squidsquad/**)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git stash*)",
      "Bash(git checkout*)",
      "Bash(git log*)",
      "Bash(git rev-list*)",
      "Bash(git tag*)",
      "Bash(git fetch*)",
      "Bash(git hash-object*)",
      "Bash(git mktree*)",
      "Bash(git commit-tree*)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(date *)",
      "Bash(stat *)",
      "Bash(rm -f .squidsquad/*)",
      "Bash(echo * > .squidsquad/*)",
      "Bash(echo * > .squidsquad/* && mv -f .squidsquad/* .squidsquad/*)",
      "Bash(mv -f .squidsquad/* .squidsquad/*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if [ -d .squidsquad ]; then V=$(grep -o [0-9][0-9.]*[0-9] .squidsquad/config.md 2>/dev/null | head -1); cat <<LOGO\n\n      ▗▄▖\n     ▟█ █▙\n    ▐█• •█▌\n   ███████\n   ▐█████▌\n    ▐▌▐▌▐▌\n  S Q U I D S Q U A D   v${V:-?}\n\nLOGO\nfi'"
          }
        ]
      }
    ]
  }
}
