                                      "Bash([ *)",
                                      "Bash(echo *)",
                                      "Bash(printf *)",
                                      "Bash(gh pr *)",
                                      "Bash(gh issue *)",
                                      "Bash(gh api *)",
                                      "Bash(code *)",
                                      "Bash(git add -A \u0026\u0026 git commit *)",
                                      "Bash(git push \u0026\u0026 git push --tags)"
                                  ]
                    },
    "hooks":  {
                  "SessionStart":  [
                                       {
                                           "matcher":  "",
                                           "hooks":  [
                                                         {
                                                             "type":  "command",
                                                             "command":  "bash -c \u0027if [ -d .squidsquad ]; then V=$(grep -o [0-9][0-9.]*[0-9] .squidsquad/config.md 2\u003e/dev/null | head -1); cat \u003c\u003cLOGO\n\n      ▗▄▖\n     ▟█ █▙\n    ▐█• •█▌\n   ███████\n   ▐█████▌\n    ▐▌▐▌▐▌\n  S Q U I D S Q U A D   v${V:-?}\n\nLOGO\nfi\u0027"
                                                         }
                                                     ]
                                       }
                                   ]
              }
}