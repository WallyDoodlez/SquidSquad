                                      "Bash(echo * \u003e .squidsquad/*/*.tmp \u0026\u0026 mv -f .squidsquad/*/*.tmp .squidsquad/*/*)",
                                      "Bash(mv -f .squidsquad/*.tmp .squidsquad/*)",
                                      "Bash(mv -f .squidsquad/*/*.tmp .squidsquad/*/*)",
                                      "Bash(rm -f .squidsquad/*)",
                                      "Bash(rm -f .squidsquad/*/*)",
                                      "Bash(rm -f .squidsquad/*/*/*)",
                                      "Bash(rm .squidsquad/*)",
                                      "Bash(rm .squidsquad/*/*)",
                                      "Edit(README.md)",
