# SquidSquad runtime (not committed)
.squidsquad/.active-role
.squidsquad/*/current-state
.squidsquad/*/.pid
.squidsquad/*/.claude-pid
.squidsquad/*/restart-log.txt
.squidsquad/*/context-pressure
.squidsquad/*/context-pressure.tmp
.squidsquad/*/.health
.squidsquad/*/.health.tmp
.squidsquad/*/.booting
.squidsquad/.local-config
.squidsquad/.backlog-cache
.squidsquad/.backlog-cache.tmp
.squidsquad/.event-state.json
.squidsquad/.event-state.json.tmp
.squidsquad/diagnostics/*.jsonl
.squidsquad/*/cycle-input.json
.squidsquad/*/cycle-output.json
.squidsquad/.harness-port

.claude/commands/squidsquad-*
.claude/settings.local.json
.claude/scheduled_tasks.lock

# SQLite scan index (per-clone, rebuildable from scan-history.md)
.squidsquad/scan-index.db
.squidsquad/scan-index.db-journal
.squidsquad/scan-index.db-wal
.squidsquad/scan-index.db-shm

# Node
node_modules/

# Python
__pycache__/
*.pyc

# CQ test cache (per-clone, rebuilt on test pass)
tests/comprehension/.cache/

# Obsidian (user-specific config, not shared)
.obsidian/

# Disposable scripts and artifacts (one-time generation, migration, debug)
references/scripts/gen_*.py
references/scripts/migrate_*.py.bak
*.scratch.py
*.scratch.md

# OS/shell artifacts
*.stackdump

.squidsquad-state/
.squidsquad/.harness-state.json

# Per-task DS review tmp files (created by model_router code-review)
.[0-9]*-phase*-*.diff
.[0-9]*-phase*-*review*.md
.[0-9]*-fixup*.diff
.[0-9]*-fixup*review*.md

# Per-call tempdirs created by assemble_pass.assemble_slot (#10444 B1).
# Must live under .squidsquad/ to pass model_router's sandbox check.
.squidsquad/tmp/
